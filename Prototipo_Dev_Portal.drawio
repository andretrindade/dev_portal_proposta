        <UserObject label="API Domínios v1.0" link="data:page/id,5QvFROxAzpzhvmq1XJUu" id="i765M6m-gPjQ1ThkUvTD-19">
          <mxCell style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontColor=#999900;" parent="i765M6m-gPjQ1ThkUvTD-0" vertex="1">
