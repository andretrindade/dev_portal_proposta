        <mxCell id="IrQibDAQRQCj4qgqw4yK-13" value="A API Predic foi projetada para fornecer acesso a dados de &lt;b&gt;amostras de análise&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="IrQibDAQRQCj4qgqw4yK-0" vertex="1">
