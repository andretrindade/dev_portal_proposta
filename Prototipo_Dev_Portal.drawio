        <mxCell id="IrQibDAQRQCj4qgqw4yK-34" value="&lt;ul&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Sandbox:&lt;/b&gt; &lt;code style=&quot;font-weight: normal;&quot;&gt;https://dev-api.sotreq.com.br/sb/predic/v1&lt;/code&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt;Homologação:&lt;/b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;code style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); background-color: transparent; font-weight: normal;&quot;&gt;https://hml-api.sotreq.com.br/predic/v1&lt;/code&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Produção:&lt;/b&gt; &lt;code style=&quot;font-weight: normal;&quot;&gt;https://api.sotreq.com.br/predic/v1&lt;/code&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;&lt;h4&gt;&lt;/h4&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontColor=#999900;" parent="IrQibDAQRQCj4qgqw4yK-0" vertex="1">
