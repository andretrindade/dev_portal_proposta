        </mxCell>
        <mxCell id="LdbPNr8AnB8A7hpditcj-1" value="&lt;div&gt;@startuml&lt;/div&gt;&lt;div&gt;!theme cerulean&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;actor &quot;Cliente&quot; as client&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;group Autenticação&lt;/div&gt;&lt;div&gt;client -&amp;gt;&amp;nbsp; &quot;Sensedia\nAPI Management&quot; : Solicita acess token - Request - [POST] /access-token - Client ID; Username; Password&lt;/div&gt;&lt;div&gt;&quot;Sensedia\nAPI Management&quot; --&amp;gt; client&amp;nbsp; &amp;nbsp;: Response - Status code 200 - access_token&lt;/div&gt;&lt;div&gt;end&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;group Acessando recursos&lt;/div&gt;&lt;div&gt;client -&amp;gt;&amp;nbsp; &quot;Sensedia\nAPI Management&quot; : Request - [GET] /sample - access_token&lt;/div&gt;&lt;div&gt;&quot;Sensedia\nAPI Management&quot; --&amp;gt; client&amp;nbsp; &amp;nbsp;: Response - Status code 200&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;client -&amp;gt;&amp;nbsp; &quot;Sensedia\nAPI Management&quot; : Request - [GET] /sample/{sampleNumber} - access_token&lt;/div&gt;&lt;div&gt;&quot;Sensedia\nAPI Management&quot; --&amp;gt; client&amp;nbsp; &amp;nbsp;: Response - Status code 200&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;client -&amp;gt;&amp;nbsp; &quot;Sensedia\nAPI Management&quot; : Request - [GET] /sample/{sampleNumber}/result - access_token&lt;/div&gt;&lt;div&gt;&quot;Sensedia\nAPI Management&quot; --&amp;gt; client&amp;nbsp; &amp;nbsp;: Response - Status code 200 - access_token&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;end&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;@enduml&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="673" y="-22" width="819" height="433" as="geometry" />
        </mxCell>
        <mxCell id="6wNE11RJOe9v2G0OOkAe-1" value="&lt;div&gt;@startuml&lt;/div&gt;&lt;div&gt;!theme cerulean&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;actor &quot;Cliente&quot; as client&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;group Obter Grant Code&lt;/div&gt;&lt;div&gt;note right of client&lt;/div&gt;&lt;div&gt;&amp;nbsp;**Requisição: POST /oauth/grant-code**&lt;/div&gt;&lt;div&gt;&amp;nbsp;Contém client_id e redirect_uri igual http:localhost/&lt;/div&gt;&lt;div&gt;end note&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;client -&amp;gt;&amp;nbsp; &quot;Sensedia\nAPI Management&quot; : Solicita a garantia de autorização através do envio do client_id (identificador do APP)&lt;/div&gt;&lt;div&gt;note right of &quot;Sensedia\nAPI Management&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp;Se client_id válido, a aplicação receberá um&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;código representando a autorização concedida.&lt;/div&gt;&lt;div&gt;end note&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&quot;Sensedia\nAPI Management&quot; --&amp;gt; client&amp;nbsp; &amp;nbsp;: Recebe codigo de autorização&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;note left of &quot;Sensedia\nAPI Management&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp;**Response: HTTP 201 Created**&lt;/div&gt;&lt;div&gt;&amp;nbsp;Contém redirect_uri igual http://localhost/?code=b748cab1-...&lt;/div&gt;&lt;div&gt;&amp;nbsp;Codigo de autorização é o atributo **code** contido no redirect_uri&lt;/div&gt;&lt;div&gt;end note&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;end&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;group Obter Access Token&lt;/div&gt;&lt;div&gt;note right of client&lt;/div&gt;&lt;div&gt;&amp;nbsp;**Requisição: [POST] /oauth/access-token **&lt;/div&gt;&lt;div&gt;&amp;nbsp;Necessario concatenar os campos client_id e client_secret separando-os por &quot;:&quot; e converter para base64&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;Contém&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; headers { Authorization : &quot;Basic clientId_e_clientSecret_em_base64&quot;}&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; body: { grant_type : &quot;authorization_code&quot;,&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; code : &quot;CODIGO_AUTORIZACAO_RECUPERADO_DO_REQUESTE_ANTERIOR&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;end note&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;client -&amp;gt;&amp;nbsp; &quot;Sensedia\nAPI Management&quot; : solicita um token de acesso através do envio das credenciais do APP solicitante e do código de autorização concedida para este APP.&lt;/div&gt;&lt;div&gt;note right of &quot;Sensedia\nAPI Management&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp;Caso as credenciais sejam válidas&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;e o código de autorização esteja ativo,&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;a aplicação receberá um token de acesso.&lt;/div&gt;&lt;div&gt;end note&lt;/div&gt;&lt;div&gt;&quot;Sensedia\nAPI Management&quot; --&amp;gt; client&amp;nbsp; &amp;nbsp;: Recebe um token&lt;/div&gt;&lt;div&gt;note left of &quot;Sensedia\nAPI Management&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp;**Response: HTTP 201 Created**&lt;/div&gt;&lt;div&gt;&amp;nbsp;Contém access_token e refresh_token&lt;/div&gt;&lt;div&gt;end note&lt;/div&gt;&lt;div&gt;end&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;group Consome o recurso&lt;/div&gt;&lt;div&gt;note right of client&lt;/div&gt;&lt;div&gt;&amp;nbsp;**Requisição: [GET] /dominios/v1/empresas/3040/centros-custo**&lt;/div&gt;&lt;div&gt;&amp;nbsp;Contém&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; headers : {client_id: CLIENT_ID, access_token: ACCESS_TOKEN}&lt;/div&gt;&lt;div&gt;end note&lt;/div&gt;&lt;div&gt;client -&amp;gt;&amp;nbsp; &quot;Sensedia\nAPI Management&quot; : Solicita dados&lt;/div&gt;&lt;div&gt;&quot;Sensedia\nAPI Management&quot; --&amp;gt; client&amp;nbsp; &amp;nbsp;: Recebe dados sobre o recurso solicitado&lt;/div&gt;&lt;div&gt;end&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;@enduml&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1939" y="414" width="1087" height="30" as="geometry" />
        </mxCell>
        <mxCell id="6wNE11RJOe9v2G0OOkAe-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;editableCssRules=.*;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="2988" y="621" width="1200" height="1073" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
